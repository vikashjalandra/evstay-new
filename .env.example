# Server-only EVStay backend origin. No admin credentials are required.
EVSTAY_API_URL=https://api.evstay.in

# Browser key restricted to your website domains; enable Maps JavaScript API.
# This NEXT_PUBLIC value must be present when building the website.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAfWSFFi71FJ8eOdXqP-YnSfVtY89i2oNE
# Optional Google Cloud map ID for Advanced Markers. Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Hotel photos, names, ratings and reviews use the backend's existing
# GOOGLE_PLACES_API_KEY with Places API (New) enabled. Keep that key on the backend.
